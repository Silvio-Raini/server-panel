# Server Panel Environment
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=true

# SQLite database path
DATABASE_PATH=/opt/server-panel/data/panel.db

# Strong random secrets (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-secret
CSRF_SECRET=change-me-to-another-long-random-secret

# Session lifetime in seconds (default 8h)
SESSION_MAX_AGE=28800

# Cookie settings (behind HTTPS reverse proxy)
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Initial admin (only used on first boot if no users exist)
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow!

# Privileged helper (absolute path, invoked via sudo)
HELPER_PATH=/usr/local/sbin/server-panel-helper

# Public URL
PUBLIC_URL=https://server.codigoworks.net

# Rate limiting
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
